{
  "name": "@fastpix/fp-react-uploader",
  "version": "0.2.0",
  "description": "FastPix React Uploader is a customizable React component for chunked, resumable file uploads with drag-and-drop, progress, and pause/resume.",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "build": "npm run clean && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react uploader",
    "react file upload",
    "chunked upload",
    "resumable uploads",
    "react component",
    "drag and drop upload",
    "upload progress",
    "pause resume upload",
    "video upload",
    "react uploads sdk",
    "web uploads",
    "fastpix uploads",
    "fastpix react uploader"
  ],
  "author": {
    "name": "FastPix, Inc",
    "email": "devs@fastpix.com",
    "url": "https://fastpix.com"
  },
  "homepage": "https://www.fastpix.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FastPix/react-web-uploader.git"
  },
  "bugs": {
    "url": "https://github.com/FastPix/react-web-uploader/issues",
    "email": "devs@fastpix.com"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fastpix/resumable-uploads": "^1.0.6"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "copyfiles": "^2.4.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
